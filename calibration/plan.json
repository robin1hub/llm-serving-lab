{
  "schema_version": 1,
  "status": "planned_not_measured",
  "target": {
    "gpu": "RTX 4090",
    "gpu_count": 1,
    "model": "Qwen3-8B",
    "weight_dtype": "bfloat16",
    "kv_dtype": "bfloat16",
    "tensor_parallel_size": 1
  },
  "controls": {
    "prefix_caching": false,
    "speculative_decoding": false,
    "cpu_offload": false,
    "preemption_for_timing_fit": false,
    "sampling": {
      "temperature": 0,
      "requested_output_tokens": 32,
      "ignore_eos": true
    },
    "block_tokens": 16,
    "gpu_memory_utilization": 0.9,
    "max_model_len": 4096,
    "max_num_seqs": 8,
    "max_num_batched_tokens": 4096,
    "chunked_prefill": false,
    "cuda_graph_mode": "record_actual_mode"
  },
  "repetitions": {
    "warmup_per_shape": 5,
    "measured_per_shape": 20,
    "seed": 42
  },
  "stages": [
    {
      "name": "capacity",
      "action": "record_engine_reported_kv_capacity_after_startup",
      "restarts": 3
    },
    {
      "name": "prefill_fit",
      "split": "fit",
      "batch_sizes": [
        1
      ],
      "new_tokens": [
        128,
        512,
        2048
      ],
      "context_tokens": [
        0
      ],
      "requested_output_tokens": 1
    },
    {
      "name": "prefill_validation",
      "split": "validation",
      "batch_sizes": [
        1
      ],
      "new_tokens": [
        256,
        1024
      ],
      "context_tokens": [
        0
      ],
      "requested_output_tokens": 1
    },
    {
      "name": "decode_fit",
      "split": "fit",
      "batch_sizes": [
        1,
        4,
        8
      ],
      "new_tokens_per_request": 1,
      "context_tokens": [
        128,
        512,
        2048
      ],
      "requested_output_tokens": 32
    },
    {
      "name": "decode_validation",
      "split": "validation",
      "batch_sizes": [
        2
      ],
      "new_tokens_per_request": 1,
      "context_tokens": [
        256,
        1024
      ],
      "requested_output_tokens": 32
    },
    {
      "name": "request_validation",
      "split": "validation",
      "initial_requests": 20,
      "arrival": "fixed_open_loop",
      "request_rates_per_s": [
        0.5,
        1,
        2
      ],
      "requested_output_tokens": 32,
      "requires_same_tokenizer_and_actual_output_lengths": true
    },
    {
      "name": "later",
      "cases": [
        "chunked_prefill_with_nonzero_context",
        "mixed_batches",
        "recompute",
        "capacity_pressure"
      ]
    }
  ],
  "notes": [
    "这是建议实验矩阵，不是执行配置；各开关需按实际vLLM版本核对支持情况。",
    "Decode context指本轮新token之前已缓存的token数，不是固定的最初prompt长度。",
    "超出显存或模型上下文的形状记为不可运行，不自动换模型或改设置。",
    "初轮只覆盖未分块Prefill与纯Decode；不能据此宣称Mixed/Recompute已校准。"
  ]
}
